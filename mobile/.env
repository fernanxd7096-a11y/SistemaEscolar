# URL base del API del backend Laravel. Debe empezar con EXPO_PUBLIC_ para
# quedar disponible en el bundle del cliente (ver https://docs.expo.dev/guides/environment-variables/).
#
# - Web / iOS Simulator (misma máquina que el backend): http://localhost:8000/api
# - Emulador Android:                                    http://10.0.2.2:8000/api
# - Dispositivo físico (Expo Go, misma red Wi-Fi):        http://<IP-LAN-de-tu-PC>:8000/api
EXPO_PUBLIC_API_URL=http://192.168.1.34:8000/api
# HONOR_PHONE_IP_ADDRESS=http://10.225.38.15:8000/api