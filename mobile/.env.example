# URL base del API del backend Laravel para la app móvil (Expo)
# Debe empezar con EXPO_PUBLIC_ para quedar disponible en el cliente.
#
# 1. Modo Local (Misma red Wi-Fi):
EXPO_PUBLIC_API_URL=http://192.168.18.16:8000/api
#
# 2. Modo Producción / Servidor Cloud en Internet (HTTPS):
# EXPO_PUBLIC_API_URL=https://api.tudominio.com/api
