{
  "expo": {
    "name": "Sistema Escolar SJT",
    "slug": "sistema-escolar-sjt-mobile",
    "scheme": "sistemaescolarsjt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.edu.sanjudastadeo.mobile"
    },
    "android": {
      "usesCleartextTraffic": true,
      "package": "pe.edu.sanjudastadeo.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0f6cbd"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa para elegir tu foto de perfil desde la galería.",
          "cameraPermission": "Se usa para tomarte una foto de perfil con la cámara."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "157f115a-8880-4894-be8e-c83514f88c89"
      }
    },
    "owner": "ferxxoo2000"
  }
}
